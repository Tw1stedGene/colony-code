<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Activity flecks thrown near an agent desk's monitor (ColonyCode.World.ColonyEffects). White glyphs with a
       dark outline; the code tints them per agent state through FleckCreationData.instanceColor. -->

  <FleckDef Name="ColonyCode_FleckGlyphBase" Abstract="True">
    <fleckSystemClass>FleckSystemThrown</fleckSystemClass>
    <graphicData>
      <graphicClass>Graphic_Fleck</graphicClass>
      <shaderType>Mote</shaderType>
      <drawSize>(0.45,0.45)</drawSize>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.7</solidTime>
    <fadeOutTime>0.5</fadeOutTime>
  </FleckDef>

  <!-- Typing / thinking: "</>" -->
  <FleckDef ParentName="ColonyCode_FleckGlyphBase">
    <defName>ColonyCode_Fleck_Code</defName>
    <graphicData>
      <texPath>Things/ColonyCode/Fleck/Code</texPath>
    </graphicData>
  </FleckDef>

  <!-- Running commands -->
  <FleckDef ParentName="ColonyCode_FleckGlyphBase">
    <defName>ColonyCode_Fleck_Gear</defName>
    <graphicData>
      <texPath>Things/ColonyCode/Fleck/Gear</texPath>
    </graphicData>
  </FleckDef>

  <!-- Testing -->
  <FleckDef ParentName="ColonyCode_FleckGlyphBase">
    <defName>ColonyCode_Fleck_TestTube</defName>
    <graphicData>
      <texPath>Things/ColonyCode/Fleck/TestTube</texPath>
    </graphicData>
  </FleckDef>

  <!-- Done / celebration -->
  <FleckDef>
    <defName>ColonyCode_Fleck_Sparkle</defName>
    <fleckSystemClass>FleckSystemThrown</fleckSystemClass>
    <graphicData>
      <graphicClass>Graphic_Fleck</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <texPath>Things/ColonyCode/Fleck/Sparkle</texPath>
      <drawSize>(0.6,0.6)</drawSize>
    </graphicData>
    <altitudeLayer>MetaOverlays</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.35</solidTime>
    <fadeOutTime>0.6</fadeOutTime>
    <growthRate>-0.4</growthRate>
  </FleckDef>

</Defs>
