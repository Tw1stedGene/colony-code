<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="ColonyCode_BuildingBase" ParentName="BuildingBase" Abstract="True">
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <designationCategory>Misc</designationCategory>
    <researchPrerequisites>
      <li>ColonyCode_Networking</li>
    </researchPrerequisites>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
  </ThingDef>

  <!-- Agent desk: each powered desk brings one remote-worker resident, who codes here while its agent is busy. -->
  <ThingDef ParentName="ColonyCode_BuildingBase">
    <defName>ColonyCode_AgentDesk</defName>
    <label>agent desk</label>
    <description>A workstation with a monitor wired to your Claude Code session. Each powered desk brings one remote worker to live in your colony. While the agent they embody is busy, they sit here and code. The Monitor tab shows the agent's live log.</description>
    <thingClass>ColonyCode.World.Building_AgentDesk</thingClass>
    <!-- Realtime part: the monitor glow (Building_AgentDesk.DrawAt). -->
    <drawerType>MapMeshAndRealTime</drawerType>
    <size>(2,1)</size>
    <graphicData>
      <texPath>Things/ColonyCode/AgentDesk</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <fillPercent>0.4</fillPercent>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Flammability>0.8</Flammability>
      <Mass>15</Mass>
      <Beauty>0</Beauty>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <interactionCellIcon>DiningChair</interactionCellIcon>
    <defaultPlacingRot>South</defaultPlacingRot>
    <surfaceType>Item</surfaceType>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <inspectorTabs>
      <li>ColonyCode.UI.ITab_AgentMonitor</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <uiOrder>2500</uiOrder>
  </ThingDef>

  <!-- Server rack: more powered racks allow more remote-worker residents. -->
  <ThingDef ParentName="ColonyCode_BuildingBase">
    <defName>ColonyCode_ServerRack</defName>
    <label>server rack</label>
    <description>Humming compute for your remote workers. Each powered rack lets two more remote workers live in the colony (three can live there without any). Each remote worker also needs a powered agent desk.</description>
    <thingClass>Building</thingClass>
    <size>(1,1)</size>
    <graphicData>
      <texPath>Things/ColonyCode/ServerRack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <fillPercent>0.5</fillPercent>
    <blockWind>true</blockWind>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Flammability>0.6</Flammability>
      <Mass>25</Mass>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>250</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(80,160,255,0)</glowColor>
      </li>
    </comps>
    <uiOrder>2501</uiOrder>
  </ThingDef>

  <!-- Decision terminal: agents waiting on you walk here; its button opens the open decisions. -->
  <ThingDef ParentName="ColonyCode_BuildingBase">
    <defName>ColonyCode_DecisionTerminal</defName>
    <label>decision terminal</label>
    <description>A console where agents bring permission requests and questions. Agents that wait on you walk here. Select it to review and answer open decisions.</description>
    <thingClass>ColonyCode.World.Building_DecisionTerminal</thingClass>
    <size>(1,1)</size>
    <graphicData>
      <texPath>Things/ColonyCode/DecisionTerminal</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <fillPercent>0.5</fillPercent>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>0.6</Flammability>
      <Mass>12</Mass>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <defaultPlacingRot>South</defaultPlacingRot>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>80</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <uiOrder>2502</uiOrder>
  </ThingDef>

  <!-- Task board: goals and their progress. -->
  <ThingDef ParentName="ColonyCode_BuildingBase">
    <defName>ColonyCode_TaskBoard</defName>
    <label>task board</label>
    <description>A board pinned with the goals and tasks your agents are working on. Select it to see Claude Code's task list as cards in three columns: to do, in progress and done.</description>
    <thingClass>ColonyCode.World.Building_TaskBoard</thingClass>
    <size>(2,1)</size>
    <graphicData>
      <texPath>Things/ColonyCode/TaskBoard</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <fillPercent>0.3</fillPercent>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Mass>8</Mass>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <WoodLog>40</WoodLog>
      <Steel>10</Steel>
    </costList>
    <defaultPlacingRot>South</defaultPlacingRot>
    <inspectorTabs>
      <li>ColonyCode.UI.ITab_TaskBoard</li>
    </inspectorTabs>
    <uiOrder>2503</uiOrder>
  </ThingDef>

  <!-- Office uplink: a sealed power unit that comes with the starting remote office. Constant output,
       no fuel. Also buildable after Networking, at a cost that keeps it from being cheap free power. -->
  <ThingDef ParentName="ColonyCode_BuildingBase">
    <defName>ColonyCode_OfficeUplink</defName>
    <label>office uplink</label>
    <description>A sealed power cell and satellite uplink that keeps a remote office running. Produces a steady 400 W, day and night, without fuel.</description>
    <thingClass>Building</thingClass>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/ColonyCode/OfficeUplink</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <fillPercent>0.5</fillPercent>
    <blockWind>true</blockWind>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Mass>20</Mass>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <designationCategory>Power</designationCategory>
    <thingCategories Inherit="False">
      <li>BuildingsPower</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-400</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Glower">
        <glowRadius>1.5</glowRadius>
        <glowColor>(80,200,140,0)</glowColor>
      </li>
    </comps>
    <uiOrder>2504</uiOrder>
  </ThingDef>

</Defs>
